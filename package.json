{
  "name": "tiny-tactics-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace=@tiny-tactics/server run dev",
    "dev:web": "npm --workspace=@tiny-tactics/web run dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,WEB\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:web\"",
    "build": "tsc -b && npm --workspace=@tiny-tactics/web run build",
    "typecheck": "tsc -b && npm --workspace=@tiny-tactics/web run typecheck",
    "test": "vitest run",
    "test:stress": "vitest run tests/stress",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@playwright/test": "^1.50.1"
  }
}
